{
    "config": {
        "fail-on-first-error": false,
        "ansi-colors": true
    },
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
                "options": {
                    "regex": "#^((build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\\([a-z0-9\\-_/., ]+\\))?!?: [a-z].+|Merge .+|Revert .+)#",
                    "error": "Commit message must follow Conventional Commits: <type>(<scope>): <description> — see conventionalcommits.org"
                }
            },
            {
                "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Rules",
                "options": [
                    "\\CaptainHook\\App\\Hook\\Message\\Rule\\MsgNotEmpty",
                    "\\CaptainHook\\App\\Hook\\Message\\Rule\\NoPeriodOnSubjectEnd",
                    ["\\CaptainHook\\App\\Hook\\Message\\Rule\\LimitSubjectLength", [72]],
                    "\\CaptainHook\\App\\Hook\\Message\\Rule\\SeparateSubjectFromBodyWithBlankLine"
                ]
            }
        ]
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\PHP\\Action\\Linting"
            },
            {
                "action": "\\CaptainHook\\App\\Hook\\Composer\\Action\\CheckLockFile"
            },
            {
                "action": "composer cs:check",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\OfType",
                        "args": ["php"]
                    }
                ]
            },
            {
                "action": "composer stan",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\OfType",
                        "args": ["php"]
                    }
                ]
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "composer test"
            }
        ]
    }
}
