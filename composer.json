{
	"name": "pietroagazzi/mechanic",
	"description": "A PHP micro web framework with MVC pattern",
	"type": "library",
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"Pietroagazzi\\Mechanic\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Pietroagazzi\\Mechanic\\Tests\\": "tests/"
		}
	},
	"authors": [
		{
			"name": "Pietro Agazzi",
			"email": "agazzi_pietro@protonmail.com"
		}
	],
	"require": {
		"php": ">=8.5"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^12.0",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"sort-packages": true
	}
}
